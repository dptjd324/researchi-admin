<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.researchi.admin.publicform.mapper.AdminJobApplicationExtraAnswerMapper">

    <resultMap id="extraAnswerResultMap" type="com.researchi.admin.publicform.domain.AdminJobApplicationExtraAnswer">
        <id property="id" column="id"/>
        <result property="applicationId" column="application_id"/>
        <result property="answerOrder" column="answer_order"/>
        <result property="questionLabel" column="question_label"/>
        <result property="answerText" column="answer_text"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.researchi.admin.publicform.domain.AdminJobApplicationExtraAnswer" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admin_job_application_extra_answer (
            application_id,
            answer_order,
            question_label,
            answer_text,
            created_at
        ) VALUES (
            #{applicationId},
            #{answerOrder},
            #{questionLabel},
            #{answerText},
            CURRENT_TIMESTAMP
        )
    </insert>

    <select id="findByApplicationId" resultMap="extraAnswerResultMap">
        SELECT
            id,
            application_id,
            answer_order,
            question_label,
            answer_text,
            created_at
        FROM admin_job_application_extra_answer
        WHERE application_id = #{applicationId}
        ORDER BY answer_order ASC, id ASC
    </select>
</mapper>
