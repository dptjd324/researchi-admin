<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.researchi.admin.form.mapper.AdminFormFieldMapper">

    <resultMap id="adminFormFieldResultMap" type="com.researchi.admin.form.domain.AdminFormField">
        <id property="id" column="id"/>
        <result property="documentSrl" column="document_srl"/>
        <result property="fieldKey" column="field_key"/>
        <result property="fieldLabel" column="field_label"/>
        <result property="fieldType" column="field_type"/>
        <result property="fieldOrder" column="field_order"/>
        <result property="requiredYn" column="required_yn"/>
        <result property="placeholderText" column="placeholder_text"/>
        <result property="helpText" column="help_text"/>
        <result property="optionsJson" column="options_json"/>
        <result property="activeYn" column="active_yn"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByDocumentSrl" resultMap="adminFormFieldResultMap">
        SELECT *
        FROM admin_form_field
        WHERE document_srl = #{documentSrl}
        ORDER BY field_order ASC, id ASC
    </select>

    <select id="findById" resultMap="adminFormFieldResultMap">
        SELECT *
        FROM admin_form_field
        WHERE id = #{id}
    </select>

    <select id="findByDocumentSrlAndFieldKey" resultMap="adminFormFieldResultMap">
        SELECT *
        FROM admin_form_field
        WHERE document_srl = #{documentSrl}
          AND field_key = #{fieldKey}
    </select>

    <insert id="insert" parameterType="com.researchi.admin.form.domain.AdminFormField" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admin_form_field (
            document_srl,
            field_key,
            field_label,
            field_type,
            field_order,
            required_yn,
            placeholder_text,
            help_text,
            options_json,
            active_yn,
            created_at,
            updated_at
        ) VALUES (
            #{documentSrl},
            #{fieldKey},
            #{fieldLabel},
            #{fieldType},
            #{fieldOrder},
            #{requiredYn},
            #{placeholderText},
            #{helpText},
            #{optionsJson},
            #{activeYn},
            CURRENT_TIMESTAMP,
            CURRENT_TIMESTAMP
        )
    </insert>

    <update id="update" parameterType="com.researchi.admin.form.domain.AdminFormField">
        UPDATE admin_form_field
        SET
            field_key = #{fieldKey},
            field_label = #{fieldLabel},
            field_type = #{fieldType},
            field_order = #{fieldOrder},
            required_yn = #{requiredYn},
            placeholder_text = #{placeholderText},
            help_text = #{helpText},
            options_json = #{optionsJson},
            active_yn = #{activeYn},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM admin_form_field
        WHERE id = #{id}
    </delete>
</mapper>
