<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.researchi.admin.notification.mapper.NotificationApplicationMapper">

    <resultMap id="notificationApplicationRecipientResultMap" type="com.researchi.admin.notification.domain.NotificationApplicationRecipient">
        <id property="applicationId" column="application_id"/>
        <result property="sourceDocumentSrl" column="document_srl"/>
        <result property="applicantName" column="applicant_name"/>
        <result property="emailAddressEnc" column="email_address_enc"/>
        <result property="emailAddressMasked" column="email_address_masked"/>
        <result property="mobilePhoneEnc" column="mobile_phone_enc"/>
        <result property="mobilePhoneMasked" column="mobile_phone_masked"/>
    </resultMap>

    <select id="findRecipientByApplicationId" resultMap="notificationApplicationRecipientResultMap">
        SELECT
            id AS application_id,
            document_srl,
            applicant_name,
            email_address_enc,
            email_address_masked,
            mobile_phone_enc,
            mobile_phone_masked
        FROM admin_job_application
        WHERE id = #{applicationId}
    </select>
</mapper>
