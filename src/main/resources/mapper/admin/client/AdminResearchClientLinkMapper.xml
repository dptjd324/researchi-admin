<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.researchi.admin.client.mapper.AdminResearchClientLinkMapper">

    <resultMap id="adminResearchClientLinkResultMap" type="com.researchi.admin.client.domain.AdminResearchClientLink">
        <id property="id" column="id"/>
        <result property="researchNo" column="research_no"/>
        <result property="clientId" column="client_id"/>
        <result property="clientName" column="client_name"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByResearchNo" resultMap="adminResearchClientLinkResultMap">
        SELECT *
        FROM admin_research_client_link
        WHERE research_no = #{researchNo}
    </select>

    <select id="findByClientId" resultMap="adminResearchClientLinkResultMap">
        SELECT *
        FROM admin_research_client_link
        WHERE client_id = #{clientId}
        ORDER BY research_no DESC
    </select>

    <insert id="upsert" parameterType="com.researchi.admin.client.domain.AdminResearchClientLink">
        INSERT INTO admin_research_client_link (
            research_no,
            client_id,
            client_name,
            created_at,
            updated_at
        ) VALUES (
            #{researchNo},
            #{clientId},
            #{clientName},
            CURRENT_TIMESTAMP,
            CURRENT_TIMESTAMP
        )
        ON DUPLICATE KEY UPDATE
            client_id = VALUES(client_id),
            client_name = VALUES(client_name),
            updated_at = CURRENT_TIMESTAMP
    </insert>

    <delete id="deleteByResearchNo">
        DELETE FROM admin_research_client_link
        WHERE research_no = #{researchNo}
    </delete>

    <delete id="deleteByClientId">
        DELETE FROM admin_research_client_link
        WHERE client_id = #{clientId}
    </delete>
</mapper>
