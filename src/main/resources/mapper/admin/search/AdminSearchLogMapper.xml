<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.researchi.admin.search.mapper.AdminSearchLogMapper">

    <resultMap id="searchLogItemResultMap" type="com.researchi.admin.search.domain.SearchLogItem">
        <id property="id" column="id"/>
        <result property="searchType" column="search_type"/>
        <result property="keywordText" column="keyword_text"/>
        <result property="conditionJson" column="condition_json"/>
        <result property="resultCount" column="result_count"/>
        <result property="searchedAt" column="searched_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.researchi.admin.search.domain.AdminSearchLog">
        INSERT INTO admin_search_log (
            search_type,
            keyword_text,
            condition_json,
            result_count,
            searched_at
        ) VALUES (
            #{searchType},
            #{keywordText},
            #{conditionJson},
            #{resultCount},
            CURRENT_TIMESTAMP
        )
    </insert>

    <select id="findAll" resultMap="searchLogItemResultMap">
        SELECT
            id,
            search_type,
            keyword_text,
            condition_json,
            result_count,
            searched_at
        FROM admin_search_log
        ORDER BY searched_at DESC, id DESC
    </select>

    <select id="findPage" resultMap="searchLogItemResultMap">
        SELECT
            id,
            search_type,
            keyword_text,
            condition_json,
            result_count,
            searched_at
        FROM admin_search_log
        ORDER BY searched_at DESC, id DESC
        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*)
        FROM admin_search_log
    </select>

    <select id="findLatestSearchedAt" resultType="java.time.LocalDateTime">
        SELECT MAX(searched_at)
        FROM admin_search_log
    </select>
</mapper>
