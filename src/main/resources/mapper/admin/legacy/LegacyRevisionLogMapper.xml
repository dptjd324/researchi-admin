<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.researchi.admin.legacy.revision.mapper.LegacyRevisionLogMapper">

    <insert id="insert" parameterType="com.researchi.admin.legacy.revision.domain.LegacyRevisionLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admin_legacy_revision_log (
            legacy_table_name,
            legacy_key,
            before_json,
            action_type,
            changed_by
        ) VALUES (
            #{legacyTableName},
            #{legacyKey},
            #{beforeJson},
            #{actionType},
            #{changedBy}
        )
    </insert>
</mapper>
