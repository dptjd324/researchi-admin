<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.researchi.admin.publicform.mapper.AdminPrivacyConsentMapper">

    <insert id="insert" parameterType="com.researchi.admin.publicform.domain.AdminPrivacyConsent" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admin_privacy_consent (
            application_id,
            consent_type,
            consent_version,
            agreed_yn,
            ip_address,
            agreed_at
        ) VALUES (
            #{applicationId},
            #{consentType},
            #{consentVersion},
            #{agreedYn},
            #{ipAddress},
            CURRENT_TIMESTAMP
        )
    </insert>
</mapper>
