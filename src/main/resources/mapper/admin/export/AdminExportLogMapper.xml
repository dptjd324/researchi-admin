<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.researchi.admin.export.mapper.AdminExportLogMapper">

    <insert id="insert" parameterType="com.researchi.admin.export.domain.AdminExportLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admin_export_log (
            document_srl,
            export_type,
            file_name,
            exported_count,
            exported_at
        ) VALUES (
            #{documentSrl},
            #{exportType},
            #{fileName},
            #{exportedCount},
            CURRENT_TIMESTAMP
        )
    </insert>
</mapper>
